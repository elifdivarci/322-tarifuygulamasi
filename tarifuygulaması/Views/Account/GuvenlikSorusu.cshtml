@{
    ViewData["Title"] = "Güvenlik Sorusu";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="auth-kart">
            <h2 class="text-center mb-2">Güvenlik Doğrulama</h2>
            <p class="text-center text-muted small mb-4">
                3 kez yanlış şifre girdiniz. Güvenlik sorunuzu cevaplayın.
            </p>

            @if (ViewBag.Hata != null)
            {
                <div class="alert alert-danger small">@ViewBag.Hata</div>
            }

            <form method="post">
                <input type="hidden" name="userId" value="@ViewBag.UserId" />

                <div class="mb-3">
                    <label class="fw-bold">@ViewBag.Soru</label>
                    <input type="text" name="cevap" class="form-control mt-2" placeholder="Cevabınız" />
                </div>

                <button type="submit" class="btn auth-btn w-100">Doğrula</button>
            </form>
        </div>
    </div>
</div>