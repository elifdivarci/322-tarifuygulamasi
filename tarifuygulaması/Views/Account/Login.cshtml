@model tarifuygulaması.Models.LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="auth-kart">
            <h2 class="text-center mb-4"> Giriş Yap</h2>

            <form method="post">
                <div asp-validation-summary="All" class="text-danger small mb-2"></div>

                <div class="mb-3">
                    <label>Email</label>
                    <input asp-for="Email" class="form-control" placeholder="email@örnek.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label>Şifre</label>
                    <input asp-for="Sifre" type="password" class="form-control" placeholder="Şifreniz" />
                    <span asp-validation-for="Sifre" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn auth-btn w-100">Giriş Yap</button>
            </form>

            <p class="text-center mt-3 small">
                Hesabınız yok mu?
                <a asp-controller="Account" asp-action="Register">Kayıt Ol</a>
            </p>
        </div>
    </div>
</div>