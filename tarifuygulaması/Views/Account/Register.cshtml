@model tarifuygulaması.Models.RegisterViewModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="auth-kart">
            <h2 class="text-center mb-4">Kayıt Ol</h2>

            <form method="post">
                <div class="mb-3">
                    <label>Ad</label>
                    <input asp-for="Ad" class="form-control" placeholder="Adınız" />
                    <span asp-validation-for="Ad" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label>Soyad</label>
                    <input asp-for="Soyad" class="form-control" placeholder="Soyadınız" />
                    <span asp-validation-for="Soyad" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label>Email</label>
                    <input asp-for="Email" class="form-control" placeholder="email@örnek.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label>Şifre</label>
                    <input asp-for="Sifre" type="password" class="form-control" placeholder="En az 6 karakter" />
                    <span asp-validation-for="Sifre" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label>Güvenlik Sorusu</label>
                    <select asp-for="SecurityQuestionId" asp-items="ViewBag.Sorular" class="form-select">
                        <option value="">-- Soru Seçiniz --</option>
                    </select>
                    <span asp-validation-for="SecurityQuestionId" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label>Güvenlik Sorusu Cevabı</label>
                    <input asp-for="SecurityAnswer" class="form-control" placeholder="Cevabınız" />
                    <span asp-validation-for="SecurityAnswer" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn auth-btn w-100">Kayıt Ol</button>
            </form>

            <p class="text-center mt-3 small">
                Zaten üye misiniz?
                <a asp-controller="Account" asp-action="Login">Giriş Yap</a>
            </p>
        </div>
    </div>
</div>