@model List<tarifuygulaması.Models.Category>

@{
    ViewData["Title"] = "Ana Sayfa";
}


<div class="hero-alan text-center py-5 mb-4">
    <h1>🍽️ Lezzetli Tarifler</h1>
    <p class="lead">Binlerce tarif, tek bir yerde!</p>
</div>


@foreach (var kategori in Model)
{
    <div class="kategori-baslik">@kategori.Ad</div>

    <div class="row g-3 mb-4">
        @foreach (var tarif in kategori.Recipes)
        {
            <div class="col-6 col-md-3">
                <a class="tarif-kart" asp-controller="Recipe" asp-action="Detail" asp-route-id="@tarif.Id">
                    <img src="@tarif.GorselUrl" alt="@tarif.Ad"
                         onerror="this.src='/images/default.jpg'" />
                    <div class="tarif-kart-body">
                        <h5>@tarif.Ad</h5>
                        <p>⏱ @(tarif.HazirlamaSuresi + tarif.PisirmeSuresi) dk &nbsp;|&nbsp; 👤 @tarif.KisiSayisi kişilik</p>
                    </div>
                </a>
            </div>
        }
    </div>
}